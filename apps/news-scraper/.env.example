# ============================================================
# News Scraper — Environment Variables
# Copy this file to .env and fill in your API keys.
# ============================================================

# ------------------------------------------------------------
# Scraping — Google News RSS (free, no API key required)
# ------------------------------------------------------------

# Number of top headlines to grab per country (default: 1)
TOP_N_HEADLINES=1

# ------------------------------------------------------------
# LLM Providers
# Set *_ENABLED=false to skip a provider without removing its key.
# ------------------------------------------------------------

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_ENABLED=true
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.0-flash

# HuggingFace — https://huggingface.co/settings/tokens
HF_API_KEY=
HF_ENABLED=true
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=true
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Max concurrent LLM API calls (across all providers)
MAX_CONCURRENT_LLM=5

# ------------------------------------------------------------
# Embeddings & Clustering (optional but recommended)
# Uses HF_API_KEY above — no separate key needed.
# ------------------------------------------------------------

ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cosine similarity threshold for "same topic" grouping (0.0–1.0)
# Lower = broader clusters, higher = tighter clusters
SIMILARITY_THRESHOLD=0.65

# Store raw embedding vectors in output JSON? (can add significant size)
STORE_EMBEDDINGS=false

# How many headlines to embed per API batch call
EMBEDDING_BATCH_SIZE=64

# ------------------------------------------------------------
# Output
# ------------------------------------------------------------

# Directory to write JSON results (relative to apps/news-scraper/)
OUTPUT_DIR=output

# ------------------------------------------------------------
# S3 Upload (optional — uploads latest.json after each run)
# ------------------------------------------------------------
S3_ENABLED=true
S3_BUCKET=jtamerius-news-data
S3_KEY=latest.json
