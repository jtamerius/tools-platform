# Cognito — injected by Amplify at build time via SSM. Do not set manually in production.
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Maritime Dataset API — injected by Amplify at build time from the CloudFormation output.
# Format: https://<api-id>.execute-api.<region>.amazonaws.com
VITE_MARITIME_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Environment label
VITE_ENV=staging
