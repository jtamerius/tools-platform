# =============================================================================
# Node.js
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# Lock files are committed per-app workspace; ignore root-level lockfiles only
# if you do not use a root workspace. Remove the lines below if you use
# npm/yarn/pnpm workspaces at the repo root.
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# =============================================================================
# Environment variables
# Keep .env.example files — they document required vars without exposing values.
# =============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
!.env.example
!**/.env.example

# =============================================================================
# Build outputs
# =============================================================================
dist/
build/
out/
.vite/
.next/
.nuxt/
.output/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
.eggs/
site-packages/
*.so
.mypy_cache/
.pytype/
.ruff_cache/

# =============================================================================
# AWS
# =============================================================================
.aws-sam/
cdk.out/
*.cfn-output.json
samconfig.toml
.amplify/
# Amplify CLI generated directory (not the infra/shared/amplify CloudFormation directory)
/amplify/

# =============================================================================
# IDE — Visual Studio Code
# Keep extensions.json so the team shares recommended extensions.
# settings.json.example documents recommended settings without forcing them.
# =============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# =============================================================================
# IDE — JetBrains / IntelliJ
# =============================================================================
.idea/
*.iml
*.ipr
*.iws

# =============================================================================
# IDE — other
# =============================================================================
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# =============================================================================
# OS-generated files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# Logs and diagnostics
# =============================================================================
*.log
logs/
*.pid
*.seed
*.pid.lock

# =============================================================================
# Testing and coverage
# =============================================================================
coverage/
.nyc_output/
*.lcov
.vitest-cache/
test-results/
playwright-report/
playwright/.cache/

# =============================================================================
# TypeScript
# =============================================================================
*.tsbuildinfo

# =============================================================================
# Miscellaneous
# =============================================================================
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tgz
apps/news-scraper/output/

# =============================================================================
# Purgatory ML — local training artifacts (never commit)
# =============================================================================
purgatory_dataset/
runs/
*.pt

# =============================================================================
# Portfolio hygiene — added before making this repo public
# =============================================================================
# Bare .env.production / .env.staging were NOT covered above (only the *.local
# variants were), which is exactly how a committed .env.production slipped in.
.env.production
.env.staging

# Build artifacts. CI builds from source; committed archives only rot.
*.zip
*.tgz

# Local tooling state
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.claude/settings.local.json

# Large local data — model weights and datasets belong in S3, not git
*.pt
*.pth
*.onnx
*.grib2
*.parquet

# Local-only agent runbooks. These are working tools (/sso, /info, /amplify-status)
# that contain account ids and live resource inventories, and several had drifted
# out of date with the code. Kept on disk, deliberately not published.
.claude/skills/*
!.claude/skills/add-app/
!.claude/skills/nav-standard/
!.claude/skills/security-policy/
!.claude/skills/model-retrain-purgatory/
